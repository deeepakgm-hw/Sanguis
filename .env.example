# Sanguis Production Environment Configuration Template
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database & Cache
MONGO_URI=mongodb://localhost:27017/sanguis
REDIS_URL=redis://localhost:6379

# Authentication & Security Secrets (min 32 chars)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_at_least_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_at_least_32_chars_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECRET=your_cookie_secret_key_32_characters

# AES-256-GCM Encryption Key (64 hex characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email Delivery (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@sanguis.org

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Maps & Geolocation
MAP_PROVIDER=leaflet
MAP_API_KEY=
LOCATION_UPDATE_INTERVAL=10000
LOCATION_MIN_DISTANCE_METERS=50

# AI Decision Engine Configuration
AI_PROVIDER=baseline
AI_API_KEY=
