NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

MONGO_URI=mongodb://localhost:27017/hackathon
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change_me_access_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_min_32_chars_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

COOKIE_SECRET=change_me_cookie_secret_min_32_chars

# AES-256-GCM key, 32 bytes hex-encoded (64 characters). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sanguis <no-reply@sanguis.app>"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Places API key for real hospital location lookup & spatial radar telemetry
GOOGLE_PLACES_API_KEY=

# RapidAPI Indian Hospitals Integration
RAPID_API_KEY=<your_rapidapi_key>

